<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/black" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

        <!-- Title Header -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/app_name" android:textColor="@color/accent_cyan" android:textSize="26sp" android:textStyle="bold" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/subtitle_effects_studio" android:textColor="#888888" android:textSize="13sp" />

        <!-- RGB Effects Studio Container -->
        <LinearLayout android:id="@+id/layoutRgbStudio" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <!-- Live Interactive Preview Canvas -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/preview_title" android:textColor="@color/accent_pink" android:textSize="14sp" android:textStyle="bold" />

            <FrameLayout android:id="@+id/previewContainer" android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginTop="8dp" android:background="@drawable/preview_box_bg">

                <TextView android:id="@+id/tvPreviewHint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/preview_hint" android:textColor="#55FFFFFF" android:textSize="13sp" />
            </FrameLayout>

            <!-- Test Keyboard Input Box -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/test_input_title" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" />

            <EditText android:id="@+id/etTestInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/input_box_bg" android:hint="@string/test_input_hint" android:padding="12dp" android:textColor="@color/white" android:textColorHint="#555555" android:textSize="14sp" />

            <!-- Dynamic Feature Switches -->
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchAmbientRain" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/switch_ambient_rain" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" />

            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchTurboDynamics" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/switch_turbo_dynamics" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" />

            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchGlideTrail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/switch_glide_trail" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" />

            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchHaptic" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/switch_haptic" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" />

            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchUnderglow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/switch_underglow" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" />

            <!-- Custom Dual-Tone Palette Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/preview_box_bg"
                android:orientation="vertical"
                android:padding="14dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchCustomColors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/switch_custom_colors"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Child container: dimmed/disabled when switchCustomColors is OFF -->
                <LinearLayout
                    android:id="@+id/layoutCustomColorsControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp"
                        android:background="#22FFFFFF" />

                    <TextView
                        android:id="@+id/tvSwatchesLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/curated_color_themes"
                        android:textColor="@color/accent_cyan"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupSwatches"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip android:id="@+id/chipSwatchNothing" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/swatch_nothing" android:textColor="@color/white" app:chipBackgroundColor="@color/card_dark" />

                        <com.google.android.material.chip.Chip android:id="@+id/chipSwatchCyberpunk" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/swatch_cyberpunk" android:textColor="@color/white" app:chipBackgroundColor="@color/card_dark" />

                        <com.google.android.material.chip.Chip android:id="@+id/chipSwatchDracula" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/swatch_dracula" android:textColor="@color/white" app:chipBackgroundColor="@color/card_dark" />

                        <com.google.android.material.chip.Chip android:id="@+id/chipSwatchSunset" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/swatch_sunset" android:textColor="@color/white" app:chipBackgroundColor="@color/card_dark" />

                        <com.google.android.material.chip.Chip android:id="@+id/chipSwatchIce" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/swatch_ice" android:textColor="@color/white" app:chipBackgroundColor="@color/card_dark" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </LinearLayout>

            <!-- 1. Visual Effect Presets & Circular Wave Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/preview_box_bg"
                android:orientation="vertical"
                android:padding="14dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchVisualEffect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/switch_visual_effect"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Child container: dimmed/disabled when switchVisualEffect is OFF -->
                <LinearLayout
                    android:id="@+id/layoutVisualEffectControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp"
                        android:background="#22FFFFFF" />

                    <!-- Effect Presets Grid/Chips -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/select_effect_preset"
                        android:textColor="@color/accent_cyan"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupEffects"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip android:id="@+id/chipWater" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/effect_water" android:textColor="@color/white" app:chipBackgroundColor="@color/card_dark" />

                        <com.google.android.material.chip.Chip android:id="@+id/chipLightning" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/effect_lightning" android:textColor="@color/white" app:chipBackgroundColor="@color/card_dark" />

                        <com.google.android.material.chip.Chip android:id="@+id/chipSupernova" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/effect_supernova" android:textColor="@color/white" app:chipBackgroundColor="@color/card_dark" />

                        <com.google.android.material.chip.Chip android:id="@+id/chipMagma" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/effect_magma" android:textColor="@color/white" app:chipBackgroundColor="@color/card_dark" />

                        <com.google.android.material.chip.Chip android:id="@+id/chipSonic" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/effect_sonic" android:textColor="@color/white" app:chipBackgroundColor="@color/card_dark" />

                        <com.google.android.material.chip.Chip android:id="@+id/chipBlackHole" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/effect_black_hole" android:textColor="@color/white" app:chipBackgroundColor="@color/card_dark" />

                        <com.google.android.material.chip.Chip android:id="@+id/chipAmbientRain" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/effect_ambient_rain" android:textColor="@color/white" app:chipBackgroundColor="@color/card_dark" />

                        <com.google.android.material.chip.Chip android:id="@+id/chipChroma" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/effect_chroma" android:textColor="@color/white" app:chipBackgroundColor="@color/card_dark" />
                    </com.google.android.material.chip.ChipGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/tuning_circular_wave"
                        android:textColor="@color/accent_cyan"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWaveSpeedLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/wave_speed_default"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderWaveSpeed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:value="1.0"
                        android:valueFrom="0.3"
                        android:valueTo="2.0"
                        android:stepSize="0.1"
                        android:saveEnabled="false" />

                    <TextView
                        android:id="@+id/tvWaveSizeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/wave_size_default"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderWaveSize"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:value="1.0"
                        android:valueFrom="0.2"
                        android:valueTo="1.5"
                        android:stepSize="0.1"
                        android:saveEnabled="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. Keycap Matrix Flow Tuning Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/preview_box_bg"
                android:orientation="vertical"
                android:padding="14dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchKeyShapeFlow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/switch_key_shape_flow"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Child container: dimmed/disabled when switchKeyShapeFlow is OFF -->
                <LinearLayout
                    android:id="@+id/layoutKeyFlowControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchKeyBorderOnly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="4dp"
                        android:text="@string/switch_key_border_only"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp"
                        android:background="#22FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tuning_key_matrix_flow"
                        android:textColor="@color/accent_cyan"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvKeyFlowSpeedLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/key_glow_speed_default"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderKeyFlowSpeed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:value="1.0"
                        android:valueFrom="0.3"
                        android:valueTo="2.0"
                        android:stepSize="0.1"
                        android:saveEnabled="false" />

                    <TextView
                        android:id="@+id/tvKeyFlowSizeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/key_glow_spread_default"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderKeyFlowSize"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:value="1.0"
                        android:valueFrom="0.2"
                        android:valueTo="1.5"
                        android:stepSize="0.1"
                        android:saveEnabled="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- Info Tip -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="24dp" android:background="#151515" android:padding="12dp" android:text="@string/info_tip" android:textColor="#AAAAAA" android:textSize="12sp" />

        </LinearLayout>
        <!-- End of layoutRgbStudio -->


    </LinearLayout>
</androidx.core.widget.NestedScrollView>
