<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/black" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

        <!-- Title Header -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Gboard RGB Studio" android:textColor="@color/accent_cyan" android:textSize="26sp" android:textStyle="bold" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="7 Fluid &amp; Reactive Visual Effects Studio" android:textColor="#888888" android:textSize="13sp" />

        <!-- RGB Effects Studio Container -->
        <LinearLayout android:id="@+id/layoutRgbStudio" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <!-- Live Interactive Preview Canvas -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Live Interactive Preview (Tap inside to test):" android:textColor="@color/accent_pink" android:textSize="14sp" android:textStyle="bold" />

            <FrameLayout android:id="@+id/previewContainer" android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginTop="8dp" android:background="@drawable/preview_box_bg">

                <TextView android:id="@+id/tvPreviewHint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="Tap anywhere in this box to trigger effect" android:textColor="#55FFFFFF" android:textSize="13sp" />
            </FrameLayout>

            <!-- Test Keyboard Input Box -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Test Typing on Gboard Here:" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" />

            <EditText android:id="@+id/etTestInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/input_box_bg" android:hint="Tap here to open Gboard..." android:padding="12dp" android:textColor="@color/white" android:textColorHint="#555555" android:textSize="14sp" />

            <!-- Dynamic Feature Switches -->
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchAmbientRain" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="🌧️ Idle Ambient Raindrops (Every 2s on keyboard)" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" />

            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchTurboDynamics" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="🔥 Turbo Typing Speed (Extra glow &amp; sparks when typing fast)" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" />

            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchGlideTrail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="✨ Swipe / Glide Neon Laser Trail" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" />

            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchHaptic" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="📳 Tactile Haptic Micro-Tick (Linear physics feedback)" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" />

            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchUnderglow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="💡 Perimeter Underglow (Mechanical edge ambient &amp; pulse glow)" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" />

            <!-- Custom Dual-Tone Palette Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/preview_box_bg"
                android:orientation="vertical"
                android:padding="14dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchCustomColors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎨 Custom Dual-Tone Palette (Override theme colors)"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Child container: dimmed/disabled when switchCustomColors is OFF -->
                <LinearLayout
                    android:id="@+id/layoutCustomColorsControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp"
                        android:background="#22FFFFFF" />

                    <TextView
                        android:id="@+id/tvSwatchesLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Curated Color Themes:"
                        android:textColor="@color/accent_cyan"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupSwatches"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip android:id="@+id/chipSwatchNothing" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔴 Nothing OS" android:textColor="@color/white" app:chipBackgroundColor="@color/card_dark" />

                        <com.google.android.material.chip.Chip android:id="@+id/chipSwatchCyberpunk" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🟡 Cyberpunk" android:textColor="@color/white" app:chipBackgroundColor="@color/card_dark" />

                        <com.google.android.material.chip.Chip android:id="@+id/chipSwatchDracula" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💜 Dracula" android:textColor="@color/white" app:chipBackgroundColor="@color/card_dark" />

                        <com.google.android.material.chip.Chip android:id="@+id/chipSwatchSunset" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌅 Sunset" android:textColor="@color/white" app:chipBackgroundColor="@color/card_dark" />

                        <com.google.android.material.chip.Chip android:id="@+id/chipSwatchIce" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="❄️ Glacier Ice" android:textColor="@color/white" app:chipBackgroundColor="@color/card_dark" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </LinearLayout>

            <!-- 1. Visual Effect Presets & Circular Wave Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/preview_box_bg"
                android:orientation="vertical"
                android:padding="14dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchVisualEffect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✨ Visual Effect Presets (Canvas ripple, sparks &amp; ambient splash)"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Child container: dimmed/disabled when switchVisualEffect is OFF -->
                <LinearLayout
                    android:id="@+id/layoutVisualEffectControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp"
                        android:background="#22FFFFFF" />

                    <!-- Effect Presets Grid/Chips -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select Visual Effect Preset:"
                        android:textColor="@color/accent_cyan"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupEffects"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip android:id="@+id/chipWater" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💧 Fluid Water" android:textColor="@color/white" app:chipBackgroundColor="@color/card_dark" />

                        <com.google.android.material.chip.Chip android:id="@+id/chipLightning" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚡ Neon Lightning" android:textColor="@color/white" app:chipBackgroundColor="@color/card_dark" />

                        <com.google.android.material.chip.Chip android:id="@+id/chipSupernova" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌌 Cosmic Supernova" android:textColor="@color/white" app:chipBackgroundColor="@color/card_dark" />

                        <com.google.android.material.chip.Chip android:id="@+id/chipMagma" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔥 Molten Magma" android:textColor="@color/white" app:chipBackgroundColor="@color/card_dark" />

                        <com.google.android.material.chip.Chip android:id="@+id/chipSonic" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔊 Sonic Wave" android:textColor="@color/white" app:chipBackgroundColor="@color/card_dark" />

                        <com.google.android.material.chip.Chip android:id="@+id/chipBlackHole" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌀 Black Hole" android:textColor="@color/white" app:chipBackgroundColor="@color/card_dark" />

                        <com.google.android.material.chip.Chip android:id="@+id/chipAmbientRain" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌧️ Ambient Rain" android:textColor="@color/white" app:chipBackgroundColor="@color/card_dark" />

                        <com.google.android.material.chip.Chip android:id="@+id/chipChroma" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌈 Razer Chroma" android:textColor="@color/white" app:chipBackgroundColor="@color/card_dark" />
                    </com.google.android.material.chip.ChipGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="🌊 Circular Wave Tuning (Visual Effects)"
                        android:textColor="@color/accent_cyan"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWaveSpeedLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Wave Speed: 1.0x (Normal)"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderWaveSpeed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:value="1.0"
                        android:valueFrom="0.3"
                        android:valueTo="2.0"
                        android:stepSize="0.1"
                        android:saveEnabled="false" />

                    <TextView
                        android:id="@+id/tvWaveSizeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Wave Size / Reach: 1.0x (Full)"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderWaveSize"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:value="1.0"
                        android:valueFrom="0.2"
                        android:valueTo="1.5"
                        android:stepSize="0.1"
                        android:saveEnabled="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. Keycap Matrix Flow Tuning Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/preview_box_bg"
                android:orientation="vertical"
                android:padding="14dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchKeyShapeFlow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⌨️ Mechanical Key Matrix (Fluid travels through keycap shapes)"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Child container: dimmed/disabled when switchKeyShapeFlow is OFF -->
                <LinearLayout
                    android:id="@+id/layoutKeyFlowControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchKeyBorderOnly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="4dp"
                        android:text="🔲 Border Rim Only (Glow key outlines only, keep letters clear)"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp"
                        android:background="#22FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⌨️ Keycap Matrix Flow Tuning (Key Shape Glow)"
                        android:textColor="@color/accent_cyan"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvKeyFlowSpeedLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Key Glow Speed: 1.0x (Normal)"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderKeyFlowSpeed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:value="1.0"
                        android:valueFrom="0.3"
                        android:valueTo="2.0"
                        android:stepSize="0.1"
                        android:saveEnabled="false" />

                    <TextView
                        android:id="@+id/tvKeyFlowSizeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Key Glow Spread: 1.0x (Full Keyboard)"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderKeyFlowSize"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:value="1.0"
                        android:valueFrom="0.2"
                        android:valueTo="1.5"
                        android:stepSize="0.1"
                        android:saveEnabled="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- Info Tip -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="24dp" android:background="#151515" android:padding="12dp" android:text="💡 Tip: Settings sync to Gboard in REAL TIME! Tapping any preset or switch updates your keyboard instantly without restarting Gboard." android:textColor="#AAAAAA" android:textSize="12sp" />

        </LinearLayout>
        <!-- End of layoutRgbStudio -->


    </LinearLayout>
</androidx.core.widget.NestedScrollView>
